# Copy to .env and fill in. Load with:  set -a && source .env && set +a
# .env is git-ignored; nothing in it is ever written to logs or results.

# ---- Modal proxy (auth: modal entries in config/models.yaml) ----
# Proxy token of the workspace that serves the endpoints
MODAL_PROXY_TOKEN_ID=wk-...
MODAL_PROXY_TOKEN_SECRET=ws-...
# Endpoint URLs of the two deployments (OpenAI-compatible, ending in /v1)
MODAL_GLM_BASE_URL=https://<workspace>--<glm-app>.modal.direct/v1
MODAL_QWEN_BASE_URL=https://<workspace>--<qwen-app>.modal.direct/v1

# ---- Optional second Modal workspace ----
# Only needed if you duplicate entries in config/models.yaml with
# token_prefix: MODAL3_ and base_url_env: MODAL3_GLM_BASE_URL / MODAL3_QWEN_BASE_URL
# (used in the reported runs to put the agents on one workspace and the judge on another).
# MODAL3_PROXY_TOKEN_ID=wk-...
# MODAL3_PROXY_TOKEN_SECRET=ws-...
# MODAL3_GLM_BASE_URL=https://...
# MODAL3_QWEN_BASE_URL=https://...

# ---- OpenRouter (the or_* agent families of the model panel) ----
OPENROUTER_API_KEY=sk-or-...
